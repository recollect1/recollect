# Leave FALKORDB_URL empty to run on the in-memory graph (local dev and tests only).
FALKORDB_URL=redis://localhost:6379
ELDER_TOKEN=change-me-elder
FAMILY_TOKEN=change-me-family
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EXTRACT_MODEL_ID=
BEDROCK_REPORT_MODEL_ID=
RECALL_MIN_SCORE=0.45
RECALL_DIRECT_MIN=0.5
RECALL_MASKED_MIN=-8.5
ONNX_THREADS=2
# DEMO_CLOCK=1 enables POST /demo/clock (family token) for the evening and night scenarios.
DEMO_CLOCK=
# SEED_SKIP=radio leaves the radio story out so it can be told live.
SEED_SKIP=
MCP_SERVER_URL=http://localhost:8787/mcp
# Optional: SMS for night alerts through Amazon SNS (§9.4). Leave empty for in-app alerts only.
SNS_TOPIC_ARN=
