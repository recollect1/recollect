# HTTPS with an automatic Let's Encrypt certificate for SITE_HOST (e.g. 3-90-12-7.sslip.io).
# /mcp and /healthz go to the MCP server (bearer token required there); everything else is the
# password-protected web service (simulator at /, family page at /family).
{$SITE_HOST} {
	encode gzip
	handle /mcp* {
		reverse_proxy mcp:8787
	}
	handle /healthz {
		reverse_proxy mcp:8787
	}
	handle {
		reverse_proxy web:8080
	}
}

# The MCP server on its own name (api.<site>): /mcp, /api/*, /report/*, /demo/*, /healthz. Every
# route there checks the bearer token itself. Used by a local simulator or family page, or by
# Claude Desktop, pointed at the deployment. The main site above keeps its password gate.
api.{$SITE_HOST} {
	encode gzip
	reverse_proxy mcp:8787
}
