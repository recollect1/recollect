{
  "name": "recollect",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @recollect/mcp-server dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @recollect/core seed",
    "eval:recall": "pnpm --filter @recollect/core eval:recall",
    "test:latency": "pnpm --filter @recollect/mcp-server test:latency"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
