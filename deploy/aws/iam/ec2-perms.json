{ "Version": "2012-10-17", "Statement": [
  { "Sid": "Bedrock", "Effect": "Allow", "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"], "Resource": "*" },
  { "Sid": "AgentCoreInvoke", "Effect": "Allow", "Action": "bedrock-agentcore:InvokeAgentRuntime", "Resource": "*" },
  { "Sid": "Params", "Effect": "Allow", "Action": ["ssm:GetParameter", "ssm:GetParametersByPath"], "Resource": "arn:aws:ssm:us-east-1:615143732705:parameter/recollect/*" },
  { "Sid": "KmsViaSsm", "Effect": "Allow", "Action": "kms:Decrypt", "Resource": "*", "Condition": { "StringEquals": { "kms:ViaService": "ssm.us-east-1.amazonaws.com" } } },
  { "Sid": "EcrToken", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*" },
  { "Sid": "EcrPushExtract", "Effect": "Allow", "Action": ["ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart",
      "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
    "Resource": "arn:aws:ecr:us-east-1:615143732705:repository/recollect-extract" }
]}
