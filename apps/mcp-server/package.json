{
  "name": "@recollect/mcp-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "test:latency": "tsx --env-file-if-exists=../../.env test/latency.ts",
    "prestart": "pnpm --filter @recollect/ui-cards build",
    "predev": "pnpm --filter @recollect/ui-cards build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@recollect/core": "workspace:*",
    "zod": "^3.25.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@recollect/ui-cards": "workspace:*"
  }
}
